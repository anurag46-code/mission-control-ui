# OpenClaw Mission Control UI Environment Variables
# Copy this file to .env.local for local development
# For Railway deployment, set these as environment variables

# OpenClaw Gateway Configuration
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_API_BASE=http://127.0.0.1:18789

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# For Railway deployment, you might need:
# OPENCLAW_GATEWAY_URL=ws://your-openclaw-gateway-url
# OPENCLAW_API_BASE=https://your-openclaw-api-url

# Optional: Customize the UI
NEXT_PUBLIC_APP_TITLE="OpenClaw Mission Control"
NEXT_PUBLIC_APP_DESCRIPTION="Real-time monitoring dashboard for OpenClaw agents"

# Note: The app uses mock data by default
# To use real OpenClaw data, you need to:
# 1. Have OpenClaw gateway running
# 2. Set the correct gateway URLs
# 3. Ensure CORS is configured properly